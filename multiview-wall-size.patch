+/** How many camera monitors the wall shows. Kept in this browser, so it stays through refreshes. */
+const WALL_SIZES = [4, 6, 8, 9, 12] as const;
+type WallSize = (typeof WALL_SIZES)[number];
+const WALL_KEY = "mkvision.wallSize.v1";
+// Whole class names on purpose, so Tailwind can see them.
+const WALL_COLS: Record<WallSize, string> = {
+  4: "grid-cols-4",
+  6: "grid-cols-3 @[40rem]:grid-cols-6",
+  8: "grid-cols-4 @[40rem]:grid-cols-8",
+  9: "grid-cols-3",
+  12: "grid-cols-4 @[40rem]:grid-cols-6",
+};
+
+function useWallSize(): [WallSize, (n: WallSize) => void] {
+  const [size, setSize] = useState<WallSize>(() => {
+    try {
+      const n = Number(window.localStorage.getItem(WALL_KEY));
+      return (WALL_SIZES as readonly number[]).includes(n) ? (n as WallSize) : 12;
+    } catch {
+      return 12;
+    }
+  });
+  const set = (n: WallSize) => {
+    setSize(n);
+    try {
+      window.localStorage.setItem(WALL_KEY, String(n));
+    } catch {
+      /* blocked storage: the choice holds until reload */
+    }
+  };
+  return [size, set];
+}
